{
  "name": "node-prod-api",
  "version": "1.0.0",
  "description": "Express 5 + MongoDB multi-tenant API (master + per-organization DBs) with feature modules, admin API + Angular admin UI, winston logging and EO bot endpoints",
  "main": "src/server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.js tests/*/*.test.js",
    "client:install": "npm --prefix client ci",
    "client:build": "npm --prefix client run build",
    "client:dev": "npm --prefix client start"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.24"
    }
  }
}
