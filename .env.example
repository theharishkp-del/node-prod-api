# =============================================================================
# node-prod-api environment configuration
# Copy to .env and adjust:  cp .env.example .env
# All values are validated at startup (src/config/index.js); the app exits with a
# clear message if something is missing or malformed.
# Never commit real credentials. .env is git-ignored.
# =============================================================================

# ---- App -------------------------------------------------------------------
# development | production | test   (development = pretty colourised console logs)
NODE_ENV=development
# Name used in logs and as the MongoDB appName
APP_NAME=node-prod-api
# Interface and port to listen on
HOST=0.0.0.0
PORT=3000
# Max JSON / urlencoded request body size (e.g. 100kb, 1mb)
BODY_LIMIT=100kb
# Max time (ms) to wait for in-flight requests and DB close on SIGTERM/SIGINT before forcing exit
SHUTDOWN_TIMEOUT_MS=10000

# ---- MongoDB ---------------------------------------------------------------
# Required. mongodb:// or mongodb+srv:// URI. Put credentials only in your real .env / secret store.
# Example with auth: mongodb://app_user:CHANGE_ME@db.example.com:27017/node_prod_api?authSource=admin
MONGODB_URI=mongodb://localhost:27017/node_prod_api
# Connection pool size per process
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=0
# How long the driver tries to find a server before failing an operation / connect attempt
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# Close sockets after this much inactivity during an operation
MONGO_SOCKET_TIMEOUT_MS=45000
# Create schema indexes after connecting. Set false if indexes are managed by migrations.
MONGO_AUTO_INDEX=true
# Startup connection attempts before exiting (0 = retry forever). Exponential backoff with jitter.
MONGO_CONNECT_RETRIES=10
MONGO_RETRY_INITIAL_DELAY_MS=1000
MONGO_RETRY_MAX_DELAY_MS=30000

# ---- Multi-tenancy -------------------------------------------------------
# One connection (MONGODB_URI), several databases selected with useDb():
#   master DB  MASTER_DB_NAME           -> organizations, bots
#   tenant DB  iq_t_<orgId> (per org)   -> eo_sessions, ...
# The database in MONGODB_URI's path is not used for data.
MASTER_DB_NAME=iq_master
# How long (seconds) a botUserId -> organization lookup is cached per process. Admin API
# changes invalidate the cache immediately on the same instance; other instances pick them
# up after this TTL. 0 = no caching.
TENANT_CACHE_TTL_SECONDS=300

# ---- Admin API (/api/admin/*) + admin UI -----------------------------------
# Static key the admin UI / clients send in the 'x-admin-key' header (min 16 chars).
# REQUIRED in production (startup fails without it). If unset in development/test the
# admin API is open and a warning is logged once. Generate e.g. with: openssl rand -hex 32
ADMIN_API_KEY=

# ---- Logging ---------------------------------------------------------------
# error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
# Directory for log files (relative to the working directory or absolute)
LOG_DIR=logs
# Write JSON log files (false = console only, e.g. when a platform collects stdout)
LOG_TO_FILE=true
# Add request/response bodies to the access log. Bodies are logged as-is (no redaction),
# so do not enable this for routes that carry secrets you must not store in logs.
LOG_BODIES=true
# Max characters of each body in the access log before truncation
LOG_BODY_MAX_LENGTH=2000
# Comma-separated exact paths to skip in the access log (e.g. /health,/health/ready)
LOG_IGNORE_PATHS=
# Start a new log file every week (app-2026-W41.log, ISO week) or every day (app-2026-10-07.log).
# weekly | daily
LOG_ROTATE_FREQUENCY=weekly
# Delete log files older than this many days
LOG_RETENTION_DAYS=30
# Also rotate within the period when a file reaches this size (k, m, g). Rotated files are gzipped.
LOG_MAX_SIZE=20m

# ---- EO bot endpoint (POST /api/customerOrderRequestEo) ---------------------
# Value returned as "fromServer" in every EO response
EO_FROM_SERVER=FSMAGENT
# true  = log the full incoming payload ('eo.request') and full response ('eo.response')
#         as-is and never truncated (the generic access log then omits its bodies for
#         this route).
# false = log only taskId, signalId, parentId, sessionDate, botUserId, decoded
#         questionKey/answerKey, resultCode, eoState.
# Unset = true in development/test, false in production.
EO_LOG_FULL=
# PLACEHOLDER: base URL for the "Book a New Order via website" link (iq+customer_menu /
# iq+customer_menu_ans_3). Optional, absolute http(s) URL. The real per-customer key/token
# format is still pending; until then the link is this URL unchanged.
EO_ORDER_BASE_URL=

# ---- HTTP ------------------------------------------------------------------
# '*' or comma-separated list of allowed origins, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGIN=*
# Allow cookies/credentials cross-origin (requires explicit origins, not '*')
CORS_CREDENTIALS=false

# ---- Sub-path + Angular static hosting ------------------------------------
# URL prefix the app lives under behind nginx (https://devvir.cognitivemobile.net/iqagent/).
# Leading slash added / trailing slash removed automatically. Empty (APP_BASE_PATH=) = root.
# Every module is served under it (/iqagent/health, /iqagent/api/customerOrderRequestEo)
# AND at the root (/health, /api/customerOrderRequestEo) for local checks.
APP_BASE_PATH=/iqagent
# Serve the admin UI (Angular build) from this process
ANGULAR_ENABLED=true
# URL segment of the Angular app -> https://devvir.cognitivemobile.net/iqagent/admin/
ANGULAR_APP_NAME=admin
# Folder that contains index.html (relative to project root or absolute).
# `npm run client:build` writes the admin UI to ./public/admin/browser (base href /iqagent/admin/).
ANGULAR_DIST_PATH=./public/admin/browser
# Optional: several apps, 'name1:path1,name2:path2' (combined with the single-app vars above)
# ANGULAR_APPS=admin:./public/admin/browser,portal:./public/portal
